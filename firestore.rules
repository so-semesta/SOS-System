rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function existing() {
      return resource.data;
    }

    function incoming() {
      return request.resource.data;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'scienceolympiad@semesta.sch.id' ||
        request.auth.token.email.matches('(?i)^scienceolympiad@semesta\\.sch\\.id$')
      );
    }

    // Note: To check roles, we fetch from the users collection or check bootstrapped super admin
    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in [
              'ADMIN', 'MANAGEMENT', 'ADMIN_SOS', 'ADMIN_STUDENT',
              'admin', 'management', 'admin_sos', 'admin_student'
            ]
          )
        )
      );
    }
    
    function isManagement() {
      return isSignedIn() && (
        isSuperAdmin() ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['MANAGEMENT', 'management']
        )
      );
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTeacher() {
       return isSignedIn() && 
              exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
              getUserDoc().role in ['TEACHER', 'teacher'];
    }

    function isParent() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserDoc().role in ['PARENT', 'parent'] &&
             getUserDoc().get('isBlocked', false) != true;
    }

    function isParentOfStudent(studentId) {
      return isParent() &&
             'linkedStudentIds' in getUserDoc() &&
             getUserDoc().linkedStudentIds is list &&
             studentId in getUserDoc().linkedStudentIds;
    }

    // 3. Validation Helpers
    function isValidUserProfile(data) {
      return (!('uid' in data) || (data.uid is string && data.uid.size() <= 128)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
             (!('name' in data) || (data.name is string && data.name.size() <= 256)) &&
             (!('role' in data) || (data.role in ['ADMIN', 'TEACHER', 'STUDENT', 'SOS', 'ADMIN_SOS', 'ADMIN_STUDENT', 'MANAGEMENT', 'PARENT', 'admin', 'teacher', 'student', 'sos', 'admin_sos', 'admin_student', 'management', 'parent'])) &&
             (!('linkedStudentIds' in data) || (data.linkedStudentIds is list && data.linkedStudentIds.size() <= 10)) &&
             (!('linkedStudentNames' in data) || (data.linkedStudentNames is list && data.linkedStudentNames.size() <= 10)) &&
             (!('relationship' in data) || (data.relationship in ['Ayah', 'Ibu', 'Wali'])) &&
             (!('activeParentLinkId' in data) || (data.activeParentLinkId is string && data.activeParentLinkId.size() <= 128)) &&
             (!('isBlocked' in data) || data.isBlocked is bool) &&
             (!('isNewStudent' in data) || data.isNewStudent is bool) &&
             (!('roleLockedByManagement' in data) || data.roleLockedByManagement is bool) &&
             (!('migratedToSosAt' in data) || data.migratedToSosAt is number) &&
             (!('createdAt' in data) || (data.createdAt is number || data.createdAt is timestamp)) && 
             (!('updatedAt' in data) || (data.updatedAt is number || data.updatedAt is timestamp));
    }

    function isValidParentLink(data) {
      return data.keys().hasAll(['id', 'parentEmail', 'parentName', 'relationship', 'studentId', 'studentName', 'studentIds', 'studentNames', 'approvalStatus', 'isActive', 'createdBy', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'parentEmail', 'parentName', 'relationship', 'phoneWa', 'studentId', 'studentName', 'studentIds', 'studentNames', 'parentUid', 'approvalStatus', 'isActive', 'approvedBy', 'approvedAt', 'rejectionReason', 'createdBy', 'createdAt', 'updatedAt', 'lastLoginAt']) &&
             isValidId(data.id) &&
             data.parentEmail is string && data.parentEmail.size() >= 5 && data.parentEmail.size() <= 256 &&
             data.parentName is string && data.parentName.size() >= 1 && data.parentName.size() <= 150 &&
             data.relationship in ['Ayah', 'Ibu', 'Wali'] &&
             (!('phoneWa' in data) || (data.phoneWa is string && data.phoneWa.size() <= 30)) &&
             isValidId(data.studentId) &&
             data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 150 &&
             data.studentIds is list && data.studentIds.size() == 1 && data.studentIds[0] == data.studentId &&
             data.studentNames is list && data.studentNames.size() == 1 && data.studentNames[0] is string &&
             (!('parentUid' in data) || (data.parentUid is string && data.parentUid.size() <= 128)) &&
             data.approvalStatus in ['PENDING', 'APPROVED', 'REJECTED'] &&
             data.isActive is bool &&
             (!('approvedBy' in data) || (data.approvedBy is string && data.approvedBy.size() <= 256)) &&
             (!('approvedAt' in data) || data.approvedAt is number) &&
             (!('rejectionReason' in data) || (data.rejectionReason is string && data.rejectionReason.size() <= 500)) &&
             data.createdBy is string && data.createdBy.size() <= 256 &&
             data.createdAt is number &&
             data.updatedAt is number &&
             (!('lastLoginAt' in data) || data.lastLoginAt is number);
    }

    function isValidStudentParentClaim(data) {
      return data.keys().hasAll(['studentId', 'linkId', 'status', 'updatedAt']) &&
             data.keys().hasOnly(['studentId', 'linkId', 'status', 'updatedAt']) &&
             isValidId(data.studentId) &&
             isValidId(data.linkId) &&
             data.status in ['PENDING', 'APPROVED', 'REJECTED'] &&
             data.updatedAt is number;
    }

    function isValidAdminRequest(data) {
      return data.keys().hasAll(['id', 'uid', 'email', 'name', 'requestedRole', 'status', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'uid', 'email', 'name', 'requestedRole', 'notes', 'status', 'reviewedBy', 'reviewedAt', 'rejectionReason', 'createdAt', 'updatedAt']) &&
             isValidId(data.id) &&
             isValidId(data.uid) &&
             data.email is string && data.email.size() >= 5 && data.email.size() <= 256 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 150 &&
             data.requestedRole in ['ADMIN', 'ADMIN_SOS', 'ADMIN_STUDENT'] &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
             data.status in ['PENDING', 'APPROVED', 'REJECTED'] &&
             (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 256)) &&
             (!('reviewedAt' in data) || data.reviewedAt is number) &&
             (!('rejectionReason' in data) || (data.rejectionReason is string && data.rejectionReason.size() <= 500)) &&
             data.createdAt is number &&
             data.updatedAt is number;
    }

    function isValidStudent(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.fullName is string && data.fullName.size() <= 256 &&
             data.createdAt is number &&
             data.updatedAt is number;
    }

    function isValidCompetition(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 256 &&
             data.status in ['OPEN', 'CLOSED'];
    }

    function isValidRegistration(data) {
      return data.studentId is string && data.studentId.size() <= 128 &&
             data.competitionId is string && data.competitionId.size() <= 128 &&
             data.status in ['PENDING', 'APPROVED', 'REJECTED'];
    }

    function isValidAchievement(data) {
      return data.studentId is string && data.studentId.size() <= 128 &&
             data.competitionId is string && data.competitionId.size() <= 128 &&
             data.medalType in ['GOLD', 'SILVER', 'BRONZE', 'FINALS', 'PARTICIPANT'];
    }

    function isValidGuidanceLog(data) {
      return data.studentId is string && data.studentId.size() <= 128 &&
             data.date is number &&
             data.academicSubject is string && data.academicSubject.size() <= 256 &&
             data.studyProgress is string && data.studyProgress.size() <= 5000 &&
             data.mood in ['GREAT', 'GOOD', 'NEUTRAL', 'BAD', 'TERRIBLE'] &&
             data.createdAt is number;
    }

    function isValidStudentCvAchievement(data) {
      return data.keys().hasAll(['id', 'studentId', 'competitionTitle', 'organizer', 'field', 'level', 'medalType', 'year', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'studentId', 'competitionTitle', 'organizer', 'field', 'level', 'medalType', 'customAchievementLabel', 'year', 'eventDate', 'certificateUrl', 'notes', 'createdAt', 'updatedAt']) &&
             isValidId(data.id) &&
             isValidId(data.studentId) &&
             data.competitionTitle is string && data.competitionTitle.size() >= 1 && data.competitionTitle.size() <= 256 &&
             data.organizer is string && data.organizer.size() >= 1 && data.organizer.size() <= 200 &&
             data.field is string && data.field.size() >= 1 && data.field.size() <= 150 &&
             data.level in ['Sekolah', 'Kota/Kabupaten', 'Provinsi', 'Nasional', 'Internasional'] &&
             data.medalType in ['GOLD', 'SILVER', 'BRONZE', 'FINALS', 'PARTICIPANT'] &&
             (!('customAchievementLabel' in data) || (data.customAchievementLabel is string && data.customAchievementLabel.size() <= 150)) &&
             data.year is number && data.year >= 2000 && data.year <= 2100 &&
             (!('eventDate' in data) || (data.eventDate is string && data.eventDate.size() <= 32)) &&
             (!('certificateUrl' in data) || (data.certificateUrl is string && data.certificateUrl.size() <= 1000)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
             data.createdAt is number &&
             data.updatedAt is number;
    }


    // ==========================================
    // 4. Collection Rules
    // ==========================================

    // Users (Profiles)
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin() || isTeacher());
      allow list: if isSignedIn() && (isAdmin() || isTeacher());
      
      // Allow creation during sign-up. Students/Teachers require @semesta.sch.id; Parents must match an APPROVED & active parentLink.
      allow create: if isSignedIn() && isValidUserProfile(incoming()) && (
                       isManagement() ||
                       (
                         isOwner(userId) &&
                         (
                           (incoming().role in ['STUDENT', 'SOS', 'TEACHER', 'student', 'sos', 'teacher'] &&
                             request.auth.token.email.lower().matches('^.*@semesta\\.sch\\.id$') &&
                             !('linkedStudentIds' in incoming()) && !('activeParentLinkId' in incoming())) ||
                           ((incoming().role in ['ADMIN', 'admin', 'MANAGEMENT', 'management', 'ADMIN_SOS', 'admin_sos', 'ADMIN_STUDENT', 'admin_student']) && isSuperAdmin()) ||
                           (incoming().role in ['PARENT', 'parent'] &&
                             request.auth.token.email_verified == true &&
                             !request.auth.token.email.lower().matches('^.*@semesta\\.sch\\.id$') &&
                             incoming().get('isBlocked', false) == false &&
                             'activeParentLinkId' in incoming() &&
                             isValidId(incoming().activeParentLinkId) &&
                             exists(/databases/$(database)/documents/parentLinks/$(incoming().activeParentLinkId)) &&
                             get(/databases/$(database)/documents/parentLinks/$(incoming().activeParentLinkId)).data.isActive == true &&
                             get(/databases/$(database)/documents/parentLinks/$(incoming().activeParentLinkId)).data.get('approvalStatus', 'APPROVED') == 'APPROVED' &&
                             get(/databases/$(database)/documents/parentLinks/$(incoming().activeParentLinkId)).data.parentEmail == request.auth.token.email.lower() &&
                             'linkedStudentIds' in incoming() &&
                             incoming().linkedStudentIds == get(/databases/$(database)/documents/parentLinks/$(incoming().activeParentLinkId)).data.studentIds)
                         )
                       )
                     );
      
      // Updates: Management/Admins can update users. Block legacy auto-migration writes ('migratedToSosAt') from un-updated clients. Parents can only sync fields from their APPROVED active parentLink.
      allow update: if isSignedIn() && isValidUserProfile(incoming()) &&
        !('migratedToSosAt' in incoming().diff(existing()).affectedKeys()) && (
        isManagement() ||
        isAdmin() || 
        (isOwner(userId) && isSuperAdmin()) ||
        (isOwner(userId) && !(existing().role in ['PARENT', 'parent']) && (
          !('role' in incoming()) || 
          incoming().role == existing().role
        ) && !('linkedStudentIds' in incoming()) && !('activeParentLinkId' in incoming())) ||
        (isOwner(userId) && existing().role in ['PARENT', 'parent'] &&
          request.auth.token.email_verified == true &&
          !request.auth.token.email.lower().matches('^.*@semesta\\.sch\\.id$') &&
          incoming().role == existing().role &&
          incoming().get('isBlocked', false) == existing().get('isBlocked', false) &&
          'activeParentLinkId' in incoming() &&
          isValidId(incoming().activeParentLinkId) &&
          exists(/databases/$(database)/documents/parentLinks/$(incoming().activeParentLinkId)) &&
          get(/databases/$(database)/documents/parentLinks/$(incoming().activeParentLinkId)).data.isActive == true &&
          get(/databases/$(database)/documents/parentLinks/$(incoming().activeParentLinkId)).data.get('approvalStatus', 'APPROVED') == 'APPROVED' &&
          get(/databases/$(database)/documents/parentLinks/$(incoming().activeParentLinkId)).data.parentEmail == request.auth.token.email.lower() &&
          incoming().linkedStudentIds == get(/databases/$(database)/documents/parentLinks/$(incoming().activeParentLinkId)).data.studentIds)
      );
      
      allow delete: if isSignedIn() && isAdmin();
    }

    // Parent / Guardian 1-to-1 Links & Registrations
    match /parentLinks/{linkId} {
      allow get: if isSignedIn() && isValidId(linkId) && (
        isAdmin() ||
        (request.auth.token.email_verified == true && existing().parentEmail == request.auth.token.email.lower())
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        (request.auth.token.email_verified == true && resource.data.parentEmail == request.auth.token.email.lower())
      );
      allow create: if isSignedIn() && isValidId(linkId) && isValidParentLink(incoming()) && incoming().id == linkId && (
        isManagement() ||
        isAdmin() ||
        (
          request.auth.token.email_verified == true &&
          !request.auth.token.email.lower().matches('^.*@semesta\\.sch\\.id$') &&
          incoming().parentEmail == request.auth.token.email.lower() &&
          incoming().parentUid == request.auth.uid &&
          incoming().approvalStatus == 'PENDING' &&
          incoming().isActive == false &&
          (!exists(/databases/$(database)/documents/studentParentClaims/$(incoming().studentId)) ||
           get(/databases/$(database)/documents/studentParentClaims/$(incoming().studentId)).data.status == 'REJECTED') &&
          existsAfter(/databases/$(database)/documents/studentParentClaims/$(incoming().studentId)) &&
          getAfter(/databases/$(database)/documents/studentParentClaims/$(incoming().studentId)).data.linkId == linkId &&
          getAfter(/databases/$(database)/documents/studentParentClaims/$(incoming().studentId)).data.status == 'PENDING'
        )
      );
      allow update: if isSignedIn() && isValidId(linkId) && isValidParentLink(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().createdAt == existing().createdAt && (
        isManagement() ||
        (request.auth.token.email_verified == true &&
         existing().parentEmail == request.auth.token.email.lower() &&
         existing().get('approvalStatus', 'APPROVED') == 'APPROVED' &&
         existing().isActive == true &&
         incoming().diff(existing()).affectedKeys().hasOnly(['parentUid', 'lastLoginAt', 'updatedAt']) &&
         incoming().parentUid == request.auth.uid)
      );
      allow delete: if isSignedIn() && isValidId(linkId) && (isManagement() || isAdmin());
    }

    // Zero-PII 1-to-1 Student Parent Claims
    match /studentParentClaims/{studentId} {
      allow get: if isSignedIn() && isValidId(studentId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(studentId) && isValidStudentParentClaim(incoming()) && incoming().studentId == studentId && (
        isManagement() ||
        isAdmin() ||
        (
          request.auth.token.email_verified == true &&
          !request.auth.token.email.lower().matches('^.*@semesta\\.sch\\.id$') &&
          incoming().status == 'PENDING' &&
          existsAfter(/databases/$(database)/documents/parentLinks/$(incoming().linkId)) &&
          getAfter(/databases/$(database)/documents/parentLinks/$(incoming().linkId)).data.parentUid == request.auth.uid &&
          getAfter(/databases/$(database)/documents/parentLinks/$(incoming().linkId)).data.approvalStatus == 'PENDING'
        )
      );
      allow update: if isSignedIn() && isValidId(studentId) && isValidStudentParentClaim(incoming()) && incoming().studentId == studentId && (
        isManagement() ||
        isAdmin() ||
        (
          request.auth.token.email_verified == true &&
          !request.auth.token.email.lower().matches('^.*@semesta\\.sch\\.id$') &&
          incoming().status == 'PENDING' &&
          existing().status == 'REJECTED' &&
          existsAfter(/databases/$(database)/documents/parentLinks/$(incoming().linkId)) &&
          getAfter(/databases/$(database)/documents/parentLinks/$(incoming().linkId)).data.parentUid == request.auth.uid &&
          getAfter(/databases/$(database)/documents/parentLinks/$(incoming().linkId)).data.approvalStatus == 'PENDING'
        )
      );
      allow delete: if isSignedIn() && isValidId(studentId) && (isManagement() || isAdmin());
    }

    // Admin Access Registration Requests (Requires Management ACC)
    match /adminRequests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (
        isManagement() ||
        existing().uid == request.auth.uid
      );
      allow list: if isSignedIn() && (
        isManagement() ||
        resource.data.uid == request.auth.uid
      );
      allow create: if isSignedIn() && isValidId(requestId) && isValidAdminRequest(incoming()) &&
                       incoming().id == requestId &&
                       incoming().uid == request.auth.uid &&
                       request.auth.token.email_verified == true &&
                       request.auth.token.email.lower().matches('^.*@semesta\\.sch\\.id$') &&
                       incoming().email == request.auth.token.email.lower() &&
                       incoming().status == 'PENDING';
      allow update: if isSignedIn() && isValidId(requestId) && isValidAdminRequest(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().uid == existing().uid &&
                       incoming().createdAt == existing().createdAt && (
        isManagement() ||
        (existing().uid == request.auth.uid &&
         existing().status == 'REJECTED' &&
         incoming().status == 'PENDING' &&
         incoming().diff(existing()).affectedKeys().hasOnly(['requestedRole', 'notes', 'status', 'updatedAt']))
      );
      allow delete: if isSignedIn() && isValidId(requestId) && isManagement();
    }

    // Students (Extended info)
    match /students/{studentId} {
      allow get: if isSignedIn() && isValidId(studentId);
      // RELAXED FOR LEADERBOARD: All logged-in users can list students.
      allow list: if isSignedIn();
      
      allow create: if isSignedIn() && isValidId(studentId) && 
                       isValidStudent(incoming()) && 
                       (incoming().userId == request.auth.uid || isAdmin());
                       
      allow update: if isSignedIn() && isValidId(studentId) && 
                       isValidStudent(incoming()) && 
                       (isAdmin() || (existing().userId == request.auth.uid && incoming().userId == existing().userId));
                       
      allow delete: if isSignedIn() && isValidId(studentId) && isAdmin();
    }

    // Competitions
    match /competitions/{competitionId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(competitionId) && (
        isAdmin() || 
        (
          request.resource.data.keys().hasAll(['isApproved']) == false || 
          request.resource.data.isApproved == false
        )
      );
      allow update: if isSignedIn() && isValidId(competitionId) && (
        isAdmin() ||
        (existing().proposedByUserId == request.auth.uid)
      );
      allow delete: if isSignedIn() && isValidId(competitionId) && (
        isAdmin() ||
        (existing().proposedByUserId == request.auth.uid)
      );
    }

    // Registrations
    match /registrations/{registrationId} {
      allow get: if isSignedIn() && isValidId(registrationId);
      // RELAXED FOR LEADERBOARD: All logged-in users can list registrations.
      allow list: if isSignedIn();
      
      // Students can register themselves with status PENDING. Admins can create with any status.
      allow create: if isSignedIn() && isValidId(registrationId) && 
                       isValidRegistration(incoming()) && 
                       (isAdmin() || (incoming().studentId == request.auth.uid && incoming().status == 'PENDING'));
                       
      // Students can't approve themselves
      allow update: if isSignedIn() && isValidId(registrationId) && 
                       isValidRegistration(incoming()) && 
                       (
                         isAdmin() || 
                         (existing().studentId == request.auth.uid && incoming().studentId == existing().studentId && incoming().status == existing().status)
                       );
                       
      allow delete: if isSignedIn() && isValidId(registrationId) && (isAdmin() || existing().studentId == request.auth.uid);
    }

    // Achievements
    match /achievements/{achievementId} {
      allow get: if isSignedIn() && isValidId(achievementId) && (existing().studentId == request.auth.uid || isAdmin() || isTeacher() || isParentOfStudent(existing().studentId));
      allow list: if isSignedIn() && (isAdmin() || isTeacher() || resource.data.studentId == request.auth.uid || isParentOfStudent(resource.data.studentId));
      
      allow write: if isSignedIn() && isValidId(achievementId) && isAdmin();
    }

    // Student Manual CV Achievements (Option A: student-owned portfolio, no Leaderboard point impact)
    match /studentCvAchievements/{cvAchievementId} {
      allow get: if isSignedIn() && isValidId(cvAchievementId) && (
        existing().studentId == request.auth.uid ||
        isAdmin() ||
        isTeacher() ||
        isParentOfStudent(existing().studentId)
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        isTeacher() ||
        resource.data.studentId == request.auth.uid ||
        isParentOfStudent(resource.data.studentId)
      );
      allow create: if isSignedIn() && isValidId(cvAchievementId) &&
                       isValidStudentCvAchievement(incoming()) &&
                       incoming().id == cvAchievementId &&
                       (incoming().studentId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isValidId(cvAchievementId) &&
                       isValidStudentCvAchievement(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().studentId == existing().studentId &&
                       incoming().createdAt == existing().createdAt &&
                       (existing().studentId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && isValidId(cvAchievementId) && (
        existing().studentId == request.auth.uid || isAdmin()
      );
    }

    // OSN
    match /osn_announcements/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(docId) && isAdmin();
    }
    
    match /osn_banksoal/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(docId) && isAdmin();
    }
    
    match /archived_competitions/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(docId) && isAdmin();
    }
    
    match /chats/{chatId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && isAdmin();
    }

    // Guidance Logs
    match /guidanceLogs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && (existing().studentId == request.auth.uid || isAdmin() || isTeacher() || isParentOfStudent(existing().studentId));
      allow list: if isSignedIn() && (isAdmin() || isTeacher() || resource.data.studentId == request.auth.uid || isParentOfStudent(resource.data.studentId));
      
      allow create: if isSignedIn() && isValidId(logId) && 
                       isValidGuidanceLog(incoming()) && 
                       incoming().studentId == request.auth.uid;
                       
      // Only admins/teachers can update or delete, or owner if strictly required, but generally append-only for students
      allow update: if isSignedIn() && isValidId(logId) && 
                       isValidGuidanceLog(incoming()) && 
                       (isAdmin() || (existing().studentId == request.auth.uid && incoming().studentId == existing().studentId));
                       
      allow delete: if isSignedIn() && isValidId(logId) && (isAdmin() || existing().studentId == request.auth.uid);
    }

    // Daily Reminder Sent Status Logs (Admin-only tracking per WIB date)
    match /dailyReminderLogs/{dateKey} {
      allow get, list: if isSignedIn() && isAdmin();
      allow create, update: if isSignedIn() && isValidId(dateKey) && isAdmin() && isValidDailyReminderLog(incoming()) && incoming().dateKey == dateKey;
      allow delete: if isSignedIn() && isValidId(dateKey) && isAdmin();
    }

    function isValidSystemEmailConfig(data) {
      return data.keys().hasAll(['smtpHost', 'smtpPort', 'smtpUser', 'fromName', 'fromEmail', 'autoScheduleEnabled', 'autoScheduleTime', 'updatedAt']) &&
             data.keys().hasOnly(['smtpHost', 'smtpPort', 'smtpSecure', 'smtpUser', 'smtpPass', 'fromName', 'fromEmail', 'autoScheduleEnabled', 'autoScheduleTime', 'updatedAt', 'updatedBy']) &&
             data.smtpHost is string && data.smtpHost.size() >= 3 && data.smtpHost.size() <= 200 &&
             data.smtpPort is number && data.smtpPort >= 1 && data.smtpPort <= 65535 &&
             (!('smtpSecure' in data) || data.smtpSecure is bool) &&
             data.smtpUser is string && data.smtpUser.size() >= 3 && data.smtpUser.size() <= 256 &&
             (!('smtpPass' in data) || (data.smtpPass is string && data.smtpPass.size() <= 256)) &&
             data.fromName is string && data.fromName.size() >= 1 && data.fromName.size() <= 150 &&
             data.fromEmail is string && data.fromEmail.size() >= 3 && data.fromEmail.size() <= 256 &&
             data.autoScheduleEnabled is bool &&
             data.autoScheduleTime is string && data.autoScheduleTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
             data.updatedAt is number &&
             (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 256));
    }

    // Persistent Email & Reminder Schedule Settings (Admin/Management ONLY)
    match /systemSettings/{settingId} {
      allow get: if isSignedIn() && isValidId(settingId) && settingId == 'emailConfig' && isAdmin();
      allow list: if isSignedIn() && isAdmin();
      allow create, update: if isSignedIn() && isValidId(settingId) && settingId == 'emailConfig' && isAdmin() && isValidSystemEmailConfig(incoming());
      allow delete: if isSignedIn() && isValidId(settingId) && isManagement();
    }

    function isValidDevicePermitLetter(data) {
      return data.keys().hasAll(['unit', 'url', 'fileName', 'updatedAt']) &&
             data.keys().hasOnly(['unit', 'url', 'fileName', 'title', 'date', 'sourceType', 'sizeBytes', 'hasChunks', 'chunkCount', 'updatedAt', 'updatedBy']) &&
             data.unit in ['SMP', 'SMA'] &&
             data.url is string && data.url.size() >= 1 && data.url.size() <= 2000 &&
             data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 300 &&
             (!('title' in data) || (data.title is string && data.title.size() <= 300)) &&
             (!('date' in data) || (data.date is string && data.date.size() <= 100)) &&
             (!('sourceType' in data) || (data.sourceType in ['default', 'upload', 'url'])) &&
             (!('sizeBytes' in data) || (data.sizeBytes is number && data.sizeBytes >= 0 && data.sizeBytes <= 10485760)) &&
             (!('hasChunks' in data) || data.hasChunks is bool) &&
             (!('chunkCount' in data) || (data.chunkCount is number && data.chunkCount >= 0 && data.chunkCount <= 25)) &&
             data.updatedAt is number &&
             (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 256));
    }

    function isValidPdfChunk(data) {
      return data.keys().hasAll(['index', 'data', 'updatedAt']) &&
             data.keys().hasOnly(['index', 'data', 'updatedAt']) &&
             data.index is number && data.index >= 0 && data.index < 25 &&
             data.data is string && data.data.size() >= 1 && data.data.size() <= 750000 &&
             data.updatedAt is number;
    }

    // Device Permits (Public read for QR code verification; Admin/Management write)
    match /devicePermits/{permitId} {
      allow read: if true;
      allow write: if isSignedIn() && isAdmin();
    }

    // Official Permit PDF Letters per Unit (SMP & SMA)
    match /devicePermitLetters/{unit} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidId(unit) && unit in ['SMP', 'SMA'] && isAdmin() && isValidDevicePermitLetter(incoming());
      allow delete: if isSignedIn() && isValidId(unit) && unit in ['SMP', 'SMA'] && isAdmin();

      match /chunks/{chunkId} {
        allow read: if true;
        allow create, update: if isSignedIn() && isValidId(unit) && unit in ['SMP', 'SMA'] && isValidId(chunkId) && isAdmin() && isValidPdfChunk(incoming());
        allow delete: if isSignedIn() && isValidId(unit) && isValidId(chunkId) && isAdmin();
      }
    }
    
    // Test collection for offline checks
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }
  }
}
