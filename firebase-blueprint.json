{
  "entities": {
    "userProfile": {
      "title": "UserProfile",
      "description": "User profile with role management",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "TEACHER", "STUDENT", "SOS", "ADMIN_SOS", "ADMIN_STUDENT", "MANAGEMENT", "PARENT", "admin", "teacher", "student", "sos", "admin_sos", "admin_student", "management", "parent"] },
        "linkedStudentIds": { "type": "array", "items": { "type": "string" } },
        "linkedStudentNames": { "type": "array", "items": { "type": "string" } },
        "relationship": { "type": "string", "enum": ["Ayah", "Ibu", "Wali"] },
        "activeParentLinkId": { "type": "string" },
        "isNewStudent": { "type": "boolean" },
        "roleLockedByManagement": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["uid", "email", "role", "createdAt", "updatedAt"]
    },
    "student": {
      "title": "Student",
      "description": "Student information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "fullName": { "type": "string" },
        "nisn": { "type": "string" },
        "grade": { "type": "string" },
        "osnField": { "type": "string" },
        "nik": { "type": "string" },
        "religion": { "type": "string" },
        "birthPlace": { "type": "string" },
        "birthDate": { "type": "number" },
        "specialNeeds": { "type": "string" },
        "isColorBlind": { "type": "boolean" },
        "weightKg": { "type": "number" },
        "heightCm": { "type": "number" },
        "activeEmail": { "type": "string" },
        "semestaEmail": { "type": "string" },
        "activePhoneWA": { "type": "string" },
        "homeAddress": { "type": "string" },
        "houseNumber": { "type": "string" },
        "rtRw": { "type": "string" },
        "postalCode": { "type": "string" },
        "fullAddress": {
          "type": "object",
          "properties": {
            "street": { "type": "string" },
            "number": { "type": "string" },
            "rtRw": { "type": "string" },
            "village": { "type": "string" },
            "district": { "type": "string" },
            "city": { "type": "string" },
            "province": { "type": "string" },
            "postalCode": { "type": "string" }
          }
        },
        "motherName": { "type": "string" },
        "motherNik": { "type": "string" },
        "motherOccupation": { "type": "string" },
        "motherEducation": { "type": "string" },
        "fatherName": { "type": "string" },
        "fatherNik": { "type": "string" },
        "fatherOccupation": { "type": "string" },
        "fatherEducation": { "type": "string" },
        "guardianContact": { "type": "string" },
        "achievementIds": { "type": "array", "items": { "type": "string" } },
        "documents": {
          "type": "object",
          "properties": {
            "photoUrl": { "type": "string" },
            "studentCardUrl": { "type": "string" },
            "familyCardUrl": { "type": "string" },
            "birthCertificateUrl": { "type": "string" },
            "idCardUrl": { "type": "string" }
          }
        },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId", "fullName", "createdAt", "updatedAt"]
    },
    "competition": {
      "title": "Competition",
      "description": "Competition information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "field": { "type": "string" },
        "registrationDeadline": { "type": "number" },
        "rounds": {
          "type": "array",
          "items": { "type": "object", "properties": { "name": { "type": "string" }, "date": { "type": "number" } } }
        },
        "fee": { "type": "number" },
        "type": { "type": "string", "enum": ["Daring", "Luring", "Hybrid"] },
        "status": { "type": "string", "enum": ["OPEN", "CLOSED"] },
        "location": { "type": "string" },
        "guidebookUrl": { "type": "string" },
        "description": { "type": "string" },
        "posterUrl": { "type": "string" },
        "curationColor": { "type": "string", "enum": ["GREEN", "YELLOW", "ORANGE", "RED"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "title", "status"]
    },
    "registration": {
      "title": "Registration",
      "description": "Student competition registration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "competitionId": { "type": "string" },
        "competitionTitle": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"] },
        "notes": { "type": "string" },
        "isRegisteredDirectly": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["studentId", "competitionId", "status"]
    },
    "achievement": {
      "title": "Achievement",
      "description": "Student achievement record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "competitionId": { "type": "string" },
        "medalType": { "type": "string", "enum": ["GOLD", "SILVER", "BRONZE", "FINALS", "PARTICIPANT"] },
        "points": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["studentId", "competitionId", "medalType"]
    },
    "osn": {
      "title": "OSN",
      "description": "OSN Placeholder",
      "type": "object",
      "properties": {
        "id": { "type": "string" }
      }
    },
    "guidanceLog": {
      "title": "GuidanceLog",
      "description": "Student daily check-in and psychological guidance log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "date": { "type": "number" },
        "academicSubject": { "type": "string" },
        "studyProgress": { "type": "string" },
        "mood": { "type": "string", "enum": ["GREAT", "GOOD", "NEUTRAL", "BAD", "TERRIBLE"] },
        "psychologicalNotes": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["studentId", "date", "academicSubject", "studyProgress", "mood", "createdAt"]
    },
    "devicePermit": {
      "title": "DevicePermit",
      "description": "Authorized device permit for SOS students",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "regNumber": { "type": "string" },
        "academicYear": { "type": "string" },
        "academicYearCode": { "type": "string" },
        "slug": { "type": "string" },
        "name": { "type": "string" },
        "gender": { "type": "string", "enum": ["L", "P"] },
        "grade": { "type": "string" },
        "osnField": { "type": "string" },
        "unit": { "type": "string", "enum": ["SMP", "SMA"] },
        "schoolName": { "type": "string" },
        "status": { "type": "string", "enum": ["APPROVED", "REJECTED", "DUE"] },
        "deviceName": { "type": "string" },
        "deviceMac": { "type": "string" },
        "deviceIp": { "type": "string" },
        "notes": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "name", "unit", "status"]
    },
    "devicePermitLetter": {
      "title": "DevicePermitLetter",
      "description": "Official signed PDF device permit letter metadata per school unit (SMP / SMA)",
      "type": "object",
      "properties": {
        "unit": { "type": "string", "enum": ["SMP", "SMA"] },
        "url": { "type": "string" },
        "fileName": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "sourceType": { "type": "string", "enum": ["default", "upload", "url"] },
        "sizeBytes": { "type": "number" },
        "hasChunks": { "type": "boolean" },
        "chunkCount": { "type": "number" },
        "updatedAt": { "type": "number" },
        "updatedBy": { "type": "string" }
      },
      "required": ["unit", "url", "fileName", "updatedAt"]
    },
    "parentLink": {
      "title": "ParentLink",
      "description": "1-to-1 parent/guardian whitelist and registration request linked to a single student",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "parentEmail": { "type": "string" },
        "parentName": { "type": "string" },
        "relationship": { "type": "string", "enum": ["Ayah", "Ibu", "Wali"] },
        "phoneWa": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentIds": { "type": "array", "items": { "type": "string" } },
        "studentNames": { "type": "array", "items": { "type": "string" } },
        "parentUid": { "type": "string" },
        "approvalStatus": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"] },
        "isActive": { "type": "boolean" },
        "approvedBy": { "type": "string" },
        "approvedAt": { "type": "number" },
        "rejectionReason": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "lastLoginAt": { "type": "number" }
      },
      "required": ["id", "parentEmail", "parentName", "relationship", "studentId", "studentName", "studentIds", "studentNames", "approvalStatus", "isActive", "createdBy", "createdAt", "updatedAt"]
    },
    "studentParentClaim": {
      "title": "StudentParentClaim",
      "description": "Uniqueness lock ensuring 1 student can only be linked to 1 parent account (zero PII)",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "linkId": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"] },
        "updatedAt": { "type": "number" }
      },
      "required": ["studentId", "linkId", "status", "updatedAt"]
    },
    "adminRequest": {
      "title": "AdminRequest",
      "description": "Self-registration request for Admin access awaiting Management approval",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "requestedRole": { "type": "string", "enum": ["ADMIN", "ADMIN_SOS", "ADMIN_STUDENT"] },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"] },
        "reviewedBy": { "type": "string" },
        "reviewedAt": { "type": "number" },
        "rejectionReason": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "uid", "email", "name", "requestedRole", "status", "createdAt", "updatedAt"]
    },
    "studentCvAchievement": {
      "title": "StudentCvAchievement",
      "description": "Student self-entered historical or external competition achievement for CV and portfolio (does not affect Leaderboard points)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "competitionTitle": { "type": "string" },
        "organizer": { "type": "string" },
        "field": { "type": "string" },
        "level": { "type": "string", "enum": ["Sekolah", "Kota/Kabupaten", "Provinsi", "Nasional", "Internasional"] },
        "medalType": { "type": "string", "enum": ["GOLD", "SILVER", "BRONZE", "FINALS", "PARTICIPANT"] },
        "customAchievementLabel": { "type": "string" },
        "year": { "type": "number" },
        "eventDate": { "type": "string" },
        "certificateUrl": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "studentId", "competitionTitle", "organizer", "field", "level", "medalType", "year", "createdAt", "updatedAt"]
    },
    "dailyReminderLog": {
      "title": "DailyReminderLog",
      "description": "Persistent status record of daily guidance reminder email dispatches per WIB date",
      "type": "object",
      "properties": {
        "dateKey": { "type": "string" },
        "reportSent": { "type": "boolean" },
        "lastSentAt": { "type": "number" },
        "lastSentMode": { "type": "string", "enum": ["AUTO", "MANUAL"] },
        "lastSentBy": { "type": "string" },
        "sentCount": { "type": "number" },
        "failedCount": { "type": "number" },
        "recipientEmails": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "number" }
      },
      "required": ["dateKey", "reportSent", "lastSentAt", "lastSentMode", "sentCount", "updatedAt"]
    },
    "systemEmailConfig": {
      "title": "SystemEmailConfig",
      "description": "Persistent SMTP and daily automated reminder schedule settings managed by Admin/Management",
      "type": "object",
      "properties": {
        "smtpHost": { "type": "string" },
        "smtpPort": { "type": "number" },
        "smtpSecure": { "type": "boolean" },
        "smtpUser": { "type": "string" },
        "smtpPass": { "type": "string" },
        "fromName": { "type": "string" },
        "fromEmail": { "type": "string" },
        "autoScheduleEnabled": { "type": "boolean" },
        "autoScheduleTime": { "type": "string" },
        "updatedAt": { "type": "number" },
        "updatedBy": { "type": "string" }
      },
      "required": ["smtpHost", "smtpPort", "smtpUser", "fromName", "fromEmail", "autoScheduleEnabled", "autoScheduleTime", "updatedAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/userProfile" },
      "description": "User profiles"
    },
    "students/{studentId}": {
      "schema": { "$ref": "#/entities/student" },
      "description": "Student records"
    },
    "competitions/{competitionId}": {
      "schema": { "$ref": "#/entities/competition" },
      "description": "Competitions"
    },
    "registrations/{registrationId}": {
      "schema": { "$ref": "#/entities/registration" },
      "description": "Student competition registrations"
    },
    "achievements/{achievementId}": {
      "schema": { "$ref": "#/entities/achievement" },
      "description": "Achievements"
    },
    "osn/{osnId}": {
      "schema": { "$ref": "#/entities/osn" },
      "description": "OSN Data"
    },
    "guidanceLogs/{logId}": {
      "schema": { "$ref": "#/entities/guidanceLog" },
      "description": "Guidance and psychological logs from students"
    },
    "devicePermits/{permitId}": {
      "schema": { "$ref": "#/entities/devicePermit" },
      "description": "Authorized device permits with status, device MAC/IP, and approval details"
    },
    "devicePermitLetters/{unit}": {
      "schema": { "$ref": "#/entities/devicePermitLetter" },
      "description": "Active official PDF permit letters for SMP and SMA units"
    },
    "parentLinks/{linkId}": {
      "schema": { "$ref": "#/entities/parentLink" },
      "description": "1-to-1 parent account registrations and Management approval status"
    },
    "studentParentClaims/{studentId}": {
      "schema": { "$ref": "#/entities/studentParentClaim" },
      "description": "Zero-PII uniqueness claim per student for 1-to-1 parent linking"
    },
    "adminRequests/{requestId}": {
      "schema": { "$ref": "#/entities/adminRequest" },
      "description": "Admin role access requests awaiting Management approval"
    },
    "studentCvAchievements/{cvAchievementId}": {
      "schema": { "$ref": "#/entities/studentCvAchievement" },
      "description": "Manual student portfolio achievements for CV printing without Leaderboard point impact"
    },
    "dailyReminderLogs/{dateKey}": {
      "schema": { "$ref": "#/entities/dailyReminderLog" },
      "description": "Persistent daily reminder sent status log per dateKey (YYYY-MM-DD WIB)"
    },
    "systemSettings/{settingId}": {
      "schema": { "$ref": "#/entities/systemEmailConfig" },
      "description": "Persistent system-wide settings such as SMTP email & daily auto-reminder schedule"
    }
  }
}
